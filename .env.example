# ========================================
# AI 爆款文章创作器 - 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 未设置的变量使用 app/config.py 中的默认值
# ========================================

# ----- 服务器 -----
SERVER_HOST=0.0.0.0
SERVER_PORT=8567

# ----- 数据库（MariaDB / MySQL）-----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_passage_creator
DB_USER=root
DB_PASSWORD=1234

# ----- Redis -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=1234

# ----- Session -----
# 生产环境务必设置随机值；不设置则使用代码内置默认值（仅限本地开发）
# SESSION_SECRET_KEY=change-me
SESSION_MAX_AGE=2592000

# ----- 密码加密盐值 -----
# 生产环境务必设置随机值；不设置则使用代码内置默认值（仅限本地开发）
# PASSWORD_SALT=change-me

# ----- AI 文本生成（OpenAI 兼容协议，必需）-----
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 留空或不支持时不传 reasoning_effort；可选值取决于服务商和模型
LLM_REASONING_EFFORT=

# ----- Pexels 图库检索（必需）-----
PEXELS_API_KEY=your-pexels-api-key
PEXELS_API_URL=https://api.pexels.com/v1/search

# ----- AI 生图（配图方式 NANO_BANANA；格式 google-genai=Google GenAI / openai=OpenAI images 兼容）-----
IMAGE_GEN_FORMAT=google-genai
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=gemini-2.5-flash-image
IMAGE_GEN_ASPECT_RATIO=16:9
IMAGE_GEN_IMAGE_SIZE=1K
IMAGE_GEN_OUTPUT_MIME_TYPE=image/png

# ----- Mermaid 流程图（由 Python 依赖 mermaidx 渲染）-----
MERMAID_BACKGROUND_COLOR=transparent
MERMAID_OUTPUT_FORMAT=svg
MERMAID_WIDTH=1200

# ----- Iconify 图标库 -----
ICONIFY_API_URL=https://api.iconify.design
ICONIFY_SEARCH_LIMIT=10
ICONIFY_DEFAULT_HEIGHT=64
ICONIFY_DEFAULT_COLOR=

# ----- 表情包（Bing 图片搜索）-----
MEME_SEARCH_URL=https://cn.bing.com/images/async
MEME_SUFFIX=表情包
MEME_TIMEOUT=10000
MEME_DEFAULT_LIMIT=3

# ----- SVG 示意图 -----
SVG_DIAGRAM_DEFAULT_WIDTH=800
SVG_DIAGRAM_DEFAULT_HEIGHT=600
SVG_DIAGRAM_FOLDER=svg-diagrams

# ----- 多智能体并行配图 -----
AGENT_IMAGE_MAX_CONCURRENCY=3
